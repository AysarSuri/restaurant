# Copy to .env locally — never commit real secrets.
NODE_ENV=development
PORT=8080
BASE_PATH=/

# Postgres connection (local or Railway Postgres plugin)
DATABASE_URL=postgresql://postgres:restaurant123@localhost:5432/restaurant

# Required in production. Generate: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# Comma-separated allowed browser origins (Railway public URL + local)
# Example: https://your-app.up.railway.app,http://127.0.0.1:5001
CORS_ORIGIN=http://127.0.0.1:5001,http://localhost:5001

# Optional: directory of built SPA (defaults for Docker/production)
# STATIC_DIR=/app/public

# Optional: PIN used for table/waiter device login (default 1234)
# TABLE_LOGIN_PIN=1234

# Local Vite → API proxy (dev only)
# API_PROXY_TARGET=http://127.0.0.1:8080
