{
  "name": "workspace",
  "version": "0.0.0",
  "private": true,
  "devDependencies": {
    "prettier": "^3.8.1",
    "typescript": "~5.9.2"
  },
  "license": "MIT",
  "scripts": {
    "preinstall": "node -e \"const{existsSync,unlinkSync}=require('fs');['package-lock.json','yarn.lock'].forEach(f=>{if(existsSync(f))unlinkSync(f)});const ua=process.env.npm_config_user_agent||'';if(!ua.includes('pnpm/')){console.error('Use pnpm instead');process.exit(1)}\"",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  }
}
